{
    "name": "varsite/platform",
    "description": "Rdzeń platformy: auth, RBAC, media, settings, SEO, audit, rejestr modułów, API.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Varsite\\Platform\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Varsite\\Platform\\PlatformServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "minimum-stability": "dev",
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0",
        "varsite/audio": "dev-main",
        "varsite/catalog": "dev-main",
        "varsite/cms": "dev-main",
        "varsite/inventory": "dev-main",
        "varsite/media": "dev-main",
        "varsite/orders": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../module-audio"
        },
        {
            "type": "path",
            "url": "../module-media"
        },
        {
            "type": "path",
            "url": "../module-cms"
        },
        {
            "type": "path",
            "url": "../module-catalog"
        },
        {
            "type": "path",
            "url": "../module-inventory"
        },
        {
            "type": "path",
            "url": "../module-orders"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Varsite\\Platform\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
